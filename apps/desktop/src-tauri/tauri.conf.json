{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "APB",
  "version": "0.2.8",
  "identifier": "dev.apb.browser",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        "shell",
        "remote-tabs",
        {
          "identifier": "local-popup",
          "windows": ["apb-popup"],
          "permissions": ["allow-overlay-responses"]
        }
      ],
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/McDakcode/ApostolProject-Browser/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdEOUIwQTAzM0FCQzEzMjAKUldRZ0U3dzZBd3FiZmZNcFRPT0RGdjB2TkhUU24vcXRuM2VIeVpCRTdQS3VlZk5aTXU1WlNBOFMK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/sidebar.bmp",
        "languages": ["English", "Russian"],
        "displayLanguageSelector": true
      }
    }
  }
}
